# Copy to .env and adjust for your machine: cp .env.example .env

# Serial ports inside the Linux container (not macOS /dev/cu.* paths)
ROBOT_PORT=/dev/ttyACM0
LEADER_PORT=/dev/ttyACM1

# Host device nodes to pass through (hardware profile on Linux)
ROBOT_DEVICE=/dev/ttyACM0
LEADER_DEVICE=/dev/ttyACM1
GRIPPER_CAM_DEVICE=/dev/video0
TOP_CAM_DEVICE=/dev/video1

ROBOT_ID=my_so_arm

# Hugging Face (optional — for record / push)
HF_TOKEN=

# Rerun viewer on the host when using --display_data=true
RERUN_HOST=host.docker.internal
RERUN_PORT=9876
RERUN_GRPC_PORT=8812

# GPU image: comma-separated extra names beyond training (e.g. pi,diffusion)
# LEROBOT_EXTRAS=training,pi
